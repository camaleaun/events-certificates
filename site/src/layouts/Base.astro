---
import '../styles/global.scss';
import { site, href } from '@libs/site';
import { alternates, localeOf } from '@libs/i18n';
import LanguageMenu from '../components/LanguageMenu.astro';
import ScenarioMenu from '../components/ScenarioMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { fill, uiOf } from '@libs/strings';
import { href as at } from '@libs/i18n';

interface Props {
	title: string;
	description: string;
	markdown?: string;
}
const { title, description, markdown } = Astro.props;
const canonical = new URL( Astro.url.pathname, Astro.site );
const og = new URL( href( 'og-image.png' ), Astro.site );
const locale = localeOf( Astro.url.pathname );
const languages = alternates( Astro.url.pathname );
const strings = uiOf( locale.code );
const full = title === site.name ? title : `${ title } · ${ site.name }`;
---
<!doctype html>
<html lang={ locale.lang }>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>try{var t=localStorage.getItem('evcert-site-theme');if(t==='light'||t==='dark'){document.documentElement.dataset.theme=t}}catch(e){}</script>
		<title>{ full }</title>
		<meta name="description" content={ description } />
		<link rel="canonical" href={ canonical } />
		<link rel="icon" href={ href( 'favicon.svg' ) } type="image/svg+xml" />
		<link rel="apple-touch-icon" href={ href( 'apple-touch-icon.png' ) } />
		{ markdown && <link rel="alternate" type="text/markdown" href={ markdown } /> }
		{ languages.length > 1 && languages.map( ( item ) => <link rel="alternate" hreflang={ item.locale.lang } href={ new URL( item.href, Astro.site ) } /> ) }
		{ languages.length > 1 && <link rel="alternate" hreflang="x-default" href={ new URL( languages[ 0 ].href, Astro.site ) } /> }
		<meta property="og:locale" content={ locale.og } />
		<meta property="og:title" content={ full } />
		<meta property="og:description" content={ description } />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={ canonical } />
		<meta property="og:image" content={ og } />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip" href="#main">{ strings.skip }</a>
		<header class="top">
			<div class="wrap">
				<a class="brand" href={ at( locale ) }><img src={ href( 'favicon.svg' ) } alt="" width="32" height="32" />{ site.name }</a>
				<nav aria-label="Main">
					<ScenarioMenu />
					<a href={ href( 'docs/' ) }>{ strings.docs }</a>
					<a class="icon" href={ site.repo } aria-label={ strings.github } title={ strings.github }><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg></a>
					<ThemeToggle />
					<LanguageMenu />
				</nav>
			</div>
		</header>
		<main id="main"><slot /></main>
		<footer class="bottom">
			<div class="wrap">Events Certificates { site.version && `${ site.version } · ` }{ fill( strings.footer, { requires: site.requires, php: site.php } ) }</div>
		</footer>
	</body>
</html>
