---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import { scenarioIds } from '@data/scenarios';
import ScenarioSwitch from '../components/ScenarioSwitch.astro';
import { featureOf, hubOf, scenarioOf, uiOf } from '@libs/strings';
import { href as at } from '@libs/i18n';
import { matrix, whereText } from '@libs/landing';
import { site, href } from '@libs/site';

interface Props {
	locale?: string;
}
const { locale = 'en' } = Astro.props;
const hub = hubOf( locale );
const strings = uiOf( locale );
const loc = { code: locale, lang: '', og: '', label: '' };
const rows = matrix( locale, scenarioIds );
---
<Base title={ site.name } description={ hub.hero.lead } markdown={ locale === 'en' ? href( 'index.md' ) : undefined }>
	<div class="wrap">
		<section class="hero">
			<h1>{ hub.hero.title }</h1>
			<p>{ hub.hero.lead }</p>
			<div class="actions">
				<a class="button" href={ site.playground }>{ hub.hero.primary }</a>
				<a class="button secondary" href={ href( 'docs/start/introduction/' ) }>{ hub.hero.secondary }</a>
				<a class="button secondary" href={ site.repo }>{ hub.hero.tertiary }</a>
			</div>
			<ScenarioSwitch />
		</section>
		<section aria-labelledby="pains">
			<h2 id="pains">{ strings.problem }</h2>
			<div class="cards">
				{ hub.order.pains.map( ( key ) => <div><h3>{ hub.pains[ key as keyof typeof hub.pains ].title }</h3><p>{ hub.pains[ key as keyof typeof hub.pains ].text }</p></div> ) }
			</div>
		</section>
		<section aria-labelledby="which">
			<h2 id="which">{ hub.which.title }</h2>
			<p>{ hub.which.lead }</p>
			<div class="cards">
				{ scenarioIds.map( ( id ) => (
					<a class="card" href={ at( loc, `${ id }/` ) }>
						<h3>{ scenarioOf( id, locale ).name }</h3>
						<p>{ scenarioOf( id, locale ).audience }</p>
						<p><strong>{ scenarioOf( id, locale ).hero.title }</strong></p>
					</a>
				) ) }
			</div>
		</section>
		<section aria-labelledby="common" class="highlights">
			<h2 id="common">{ hub.common.title }</h2>
			{ hub.order.core.map( ( key ) => (
				<article class="highlight">
					<div>
						<h3>{ featureOf( key, locale ).title }</h3>
						<p>{ featureOf( key, locale ).text }</p>
						<p><a href={ href( `docs/${ featureOf( key, locale ).docs }/` ) }>{ strings.howItWorks }</a></p>
					</div>
					{ featureOf( key, locale ).screenshot && <Shot id={ featureOf( key, locale ).screenshot! } /> }
				</article>
			) ) }
		</section>
		<section aria-labelledby="compare">
			<h2 id="compare">{ hub.compare.title }</h2>
			<p>{ hub.compare.lead }</p>
			<div class="table-scroll">
				<table class="matrix">
					<thead><tr><th scope="col">{ strings.feature }</th>{ scenarioIds.map( ( id ) => <th scope="col">{ scenarioOf( id, locale ).name }</th> ) }</tr></thead>
					<tbody>
						{ rows.map( ( row ) => (
							<tr><th scope="row">{ row.feature.title }</th>{ row.cells.map( ( cell ) => <td>{ whereText( cell.where, strings ) }</td> ) }</tr>
						) ) }
					</tbody>
				</table>
			</div>
		</section>
		<section aria-labelledby="finale">
			<h2 id="finale">{ hub.finale.title }</h2>
			<p>{ hub.finale.text }</p>
			<div class="actions"><a class="button" href={ site.playground }>{ hub.hero.primary }</a></div>
		</section>
	</div>
</Base>
