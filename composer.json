{
    "name": "wpbrasil/events-certificates",
    "description": "Verifiable attendance certificates for events.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "camaleaun",
            "homepage": "https://profiles.wordpress.org/camaleaun/"
        }
    ],
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^3.1",
        "chillerlan/php-qrcode": "^4.4",
        "camaleaun/draw": "^0.15"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3",
        "phpcompatibility/phpcompatibility-wp": "*",
        "php-parallel-lint/php-parallel-lint": "^1",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2",
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "php-stubs/wp-cli-stubs": "^2.12"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "7.4.33"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude includes/third-party --exclude node_modules --exclude build --exclude build-signer --exclude docs --exclude site .",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit",
        "test:none": [
            "@putenv EVCERT_INTEGRATIONS=none",
            "@test"
        ],
        "test:camptix": [
            "@putenv EVCERT_INTEGRATIONS=camptix",
            "@test"
        ],
        "test:gatherpress": [
            "@putenv EVCERT_INTEGRATIONS=gatherpress",
            "@test"
        ],
        "test:both": [
            "@putenv EVCERT_INTEGRATIONS=both",
            "@test"
        ],
        "test:all": [
            "@test:none",
            "@test:camptix",
            "@test:gatherpress",
            "@test:both"
        ],
        "check-pot": "bash bin/make-pot.sh --check",
        "check": [
            "@lint",
            "@phpcs",
            "@check-pot",
            "@test:all"
        ],
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "scripts-descriptions": {
        "lint": "PHP syntax check of every file.",
        "phpcs": "WordPress Coding Standards and PHP 7.4+ compatibility.",
        "phpcbf": "Fix what PHPCS can fix automatically.",
        "test": "PHPUnit tests (loads the WordPress site the plugin is installed in; set WP_LOAD for another).",
        "check-pot": "Fail when languages/events-certificates.pot is out of date (run npm run build first).",
        "check": "Lint, PHPCS, the translation template and tests."
    },
    "repositories": [
        {
            "name": "draw",
            "type": "vcs",
            "url": "https://github.com/camaleaun/draw"
        }
    ]
}
