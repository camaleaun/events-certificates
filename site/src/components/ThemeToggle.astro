---
// Light or dark: the site follows the system until the visitor picks one; the choice is kept in localStorage (applied in <head> before paint).
import { localeOf } from '@libs/i18n';
import { uiOf } from '@libs/strings';

const strings = uiOf( localeOf( Astro.url.pathname ).code );
---
<button type="button" class="theme" aria-label={ strings.theme } title={ strings.theme }>
	<svg class="theme__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
	<svg class="theme__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
</button>
<script>
	const key = 'evcert-site-theme';
	document.querySelector( '.theme' )?.addEventListener( 'click', () => {
		const dark = document.documentElement.dataset.theme
			? document.documentElement.dataset.theme === 'dark'
			: matchMedia( '(prefers-color-scheme: dark)' ).matches;
		const next = dark ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem( key, next );
		} catch {}
	} );
</script>
